# Rust
/target
/vendor
# EXCEPT the hand-patched SCTP crate: unlike the bootstrap-generated
# moonlight checkout, this copy carries a repository-owned behavioral fix
# (clock-step RTT — see vendor/webrtc-sctp/Cargo.toml header) and IS the
# source of truth for the [patch] in the workspace root.
!/vendor/webrtc-sctp/
finalOutput
ignore
# Release-mode local web asset copy (built from dist/, see README "release mode")
/static

# Pinned prebuilt third-party (bootstrap scripts recreate; see tools/)
/third-party

# GJC runtime state
/.gjc

# VsCode
.vscode

# npm / js
node_modules
dist
bindings
web/api_bindings.ts

# Server
server

# Benchmark run outputs (scripts and profiles live under tools/benchmark)
/benchmark-results

/.idea

# Loose runtime binaries at the repo root (run-in-place artifacts)
/*.exe
/*.dll

# Local-only helper scripts (machine-specific paths, not for the repo)
*.local.ps1

# Stray tool dumps (cargo metadata etc.)
/meta.json
/meta.err

+// 0x5509 bitrate ACK callback storage (mirrors connection.rs GLOBAL_CONNECTION_LISTENER
+// pattern). The C layer calls the extern "C" trampoline on the control receive thread;
+// the trampoline locks this static and routes to the Rust closure.
+static GLOBAL_BITRATE_ACK_CALLBACK: Mutex<Option<Box<dyn Fn(u32, u32) + Send + 'static>>> =

+   * byte offsets where the 2nd..Nth VCL NALs start — the cut points for
+   * slice-aligned FEC blocks. Annex-B scan; each cut points at a `00 00 01`
+   * prefix, so a preceding zero of a 4-byte start code stays with the
+   * previous group as a legal trailing zero.
+   *
+   * videoFormat: 0 = H.264 (VCL nal_unit_type 1..5),
+   *              1 = HEVC (VCL nal_unit_type 0..31). AV1 is excluded by
+   * the caller (no slices on the wire).
+   */
+  std::vector<size_t>
+  vcl_slice_cut_points(const std::string_view &payload, int videoFormat) {
+    std::vector<size_t> cuts;
+    bool seen_first_vcl = false;
+    const auto *data = (const uint8_t *) payload.data();
+    const size_t size = payload.size();
+    size_t i = 0;
+    while (i + 3 < size) {
+      // Standard start-code scan: a byte > 1 at i+2 can't be part of a
+      // 00 00 01 prefix ending there or later than i+2.
+      if (data[i + 2] > 1) {
+        i += 3;
+        continue;
+      }
+      if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+        const uint8_t nal = data[i + 3];
+        const bool vcl = videoFormat == 0 ?
+                           ((nal & 0x1F) >= 1 && (nal & 0x1F) <= 5) :
+                           (((nal >> 1) & 0x3F) < 32);
+        if (vcl) {
+          if (seen_first_vcl) {
+            cuts.push_back(i);
+          }
+          seen_first_vcl = true;
+        }
+        i += 3;
+        continue;
+      }
+      ++i;
+    }
+    return cuts;
+  }

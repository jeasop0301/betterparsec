diff --git a/src/ControlStream.c b/src/ControlStream.c
index 2b5182e..5c7dca0 100644
--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -2084,3 +2084,35 @@ bool LiGetHdrMetadata(PSS_HDR_METADATA metadata) {
     *metadata = hdrMetadata;
     return true;
 }
+
+int LiChangeBitrate(int bitrateKbps) {
+    // 0x5506 is a non-standard Sunshine extension implemented by compatible
+    // hosts such as Foundation Sunshine. There is no capability bit or reply,
+    // so success here only means that ENet accepted the reliable message.
+    if (!IS_SUNSHINE() ||
+            !(SunshineFeatureFlags & LI_FF_DYNAMIC_BITRATE) ||
+            !encryptedControlStream ||
+            peer == NULL) {
+        return LI_ERR_UNSUPPORTED;
+    }
+
+    if (bitrateKbps <= 0 || bitrateKbps > 800000) {
+        return -1;
+    }
+
+    uint32_t payload[2] = {
+        LE32(2), // video::dynamic_param_type_e::BITRATE
+        LE32((uint32_t)bitrateKbps),
+    };
+
+    if (!sendMessageAndDiscardReply(0x5506,
+                                    sizeof(payload),
+                                    payload,
+                                    CTRL_CHANNEL_GENERIC,
+                                    ENET_PACKET_FLAG_RELIABLE,
+                                    false)) {
+        return -1;
+    }
+
+    return 0;
+}
diff --git a/src/Limelight.h b/src/Limelight.h

; BetterParsec keyboard-class upper filter -- test-signed prototype only.
; This package intentionally installs no hardware-ID device. It is a class filter
; and is not for production distribution or automatic deployment.

[Version]
Signature="$WINDOWS NT$"
Class=Keyboard
ClassGuid={4D36E96B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=07/18/2026,0.1.0.0
CatalogFile=betterparsec-kbdflt.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=BetterParsecKbdFlt,0x00000002,ServiceInstall

[DriverCopyFiles]
betterparsec-kbdflt.sys


[ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\betterparsec-kbdflt.sys

[Strings]
ProviderName="BetterParsec"
ServiceName="BetterParsec Keyboard Filter (Test Prototype)"

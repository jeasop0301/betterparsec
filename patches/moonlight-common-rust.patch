+unsafe extern "C" fn bitrate_ack_trampoline(applied_kbps: u32, status: u32) {
+    // Called on the moonlight-common-c control receive thread. Must not block.
+    let lock = GLOBAL_BITRATE_ACK_CALLBACK
+        .lock()
+        .unwrap_or_else(|e| e.into_inner());
+    if let Some(cb) = lock.as_ref() {
+        cb(applied_kbps, status);
+    }
